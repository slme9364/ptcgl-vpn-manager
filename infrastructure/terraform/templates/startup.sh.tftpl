#!/bin/bash
set -euo pipefail
umask 077
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends wireguard nftables unattended-upgrades ca-certificates curl
METADATA="http://metadata.google.internal/computeMetadata/v1"
report_status() {
  curl --fail --silent --show-error --request PUT \
    -H 'Metadata-Flavor: Google' \
    --data "$1" \
    "$METADATA/instance/guest-attributes/ptcgl-vpn/status"
}
report_status provisioning
trap 'report_status failed || true' ERR
install -d -m 700 /etc/wireguard
TOKEN="$(curl --fail --silent --show-error -H 'Metadata-Flavor: Google' "$METADATA/instance/service-accounts/default/token" | python3 -c 'import json,sys; print(json.load(sys.stdin)["access_token"])')"
SECRET_RESPONSE="$(curl --fail --silent --show-error -H "Authorization: Bearer $TOKEN" "https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/${server_key_secret}/versions/latest:access")"
printf '%s' "$SECRET_RESPONSE" | python3 -c 'import base64,json,sys; sys.stdout.buffer.write(base64.b64decode(json.load(sys.stdin)["payload"]["data"]))' > /etc/wireguard/server.key
chmod 600 /etc/wireguard/server.key
wg pubkey < /etc/wireguard/server.key > /etc/wireguard/server.pub
unset TOKEN SECRET_RESPONSE
WAN_IF="$(ip -o -4 route show to default | awk '{print $5; exit}')"
cat > /etc/wireguard/wg0.conf <<EOF
[Interface]
Address = ${server_address}
ListenPort = ${port}
PrivateKey = $(cat /etc/wireguard/server.key)
PostUp = nft add table ip ptcglvpn; nft 'add chain ip ptcglvpn forward { type filter hook forward priority 0; policy drop; }'; nft add rule ip ptcglvpn forward iifname wg0 oifname "$WAN_IF" accept; nft add rule ip ptcglvpn forward iifname "$WAN_IF" oifname wg0 ct state established,related accept; nft 'add chain ip ptcglvpn postrouting { type nat hook postrouting priority 100; }'; nft add rule ip ptcglvpn postrouting oifname "$WAN_IF" masquerade
PostDown = nft delete table ip ptcglvpn
%{ for peer in peers ~}

# ${peer.name}
[Peer]
PublicKey = ${peer.public_key}
AllowedIPs = ${peer.address}
%{ endfor ~}
EOF
chmod 600 /etc/wireguard/wg0.conf /etc/wireguard/server.key
cat > /etc/sysctl.d/99-wireguard-forward.conf <<'EOF'
net.ipv4.ip_forward=1
net.ipv6.conf.all.disable_ipv6=1
net.ipv6.conf.default.disable_ipv6=1
EOF
sysctl --system
systemctl enable --now wg-quick@wg0
cat > /etc/systemd/system/ptcgl-vpn-autostop.service <<'EOF'
[Unit]
Description=Stop this VM after maximum VPN runtime
[Service]
Type=oneshot
ExecStart=/sbin/shutdown -h now
EOF
cat > /etc/systemd/system/ptcgl-vpn-autostop.timer <<EOF
[Unit]
Description=Maximum runtime safety timer
[Timer]
OnActiveSec=${max_runtime_minutes}min
AccuracySec=1min
Unit=ptcgl-vpn-autostop.service
[Install]
WantedBy=timers.target
EOF
systemctl daemon-reload
systemctl enable --now ptcgl-vpn-autostop.timer
report_status ready
trap - ERR
